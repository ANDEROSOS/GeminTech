# ─── GeminTech v3.1 ───────────────────────────────────────────
# Copia este archivo como .env y configura con tus datos.
#
# La IP del VPS se AUTO-DETECTA al arrancar la API.
# Solo define VPS_IP si necesitas sobreescribirla.
#
# Despues de instalar, los .env se crean automaticamente en:
#   /opt/gemintech/api/.env  (API)
#   /etc/gemintech/.env      (Panel bash)
# ──────────────────────────────────────────────────────────────

# API FastAPI
API_KEY=Ecuador2026_Secreto_Api
API_PORT=9000

# VPS — dejar vacio para auto-deteccion
# VPS_IP=

# Directorio de datos
VPS_DIR=/etc/gemintech

# WebSocket
WS_KEY=Ecuador2026
