# ============================================================
# GeminTech — Variables de Entorno
# ============================================================

# ─── VPS ──────────────────────────────────────────────────────
# Dejar en blanco para auto-detectar la IP del VPS durante instalación
VPS_IP=
VPS_DIR=/etc/gemintech

# ─── API FastAPI ──────────────────────────────────────────────
# La clave que conecta el panel web con el backend
API_KEY=Ecuador2026_Secreto_Api
API_PORT=9000

# ─── Cloud Run ────────────────────────────────────────────────
# Configurar antes de ejecutar: bash cloudrun/deploy.sh
PROXY_TARGETS=VPS_IP:80
KEY_TARGETS=Ecuador2026_Secreto

# ─── Firebase (opcional) ──────────────────────────────────────
FIREBASE_URL=https://videocall-71a95-default-rtdb.firebaseio.com
